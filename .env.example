# Azure AI Document Intelligence (only needed for --backend azure)
AZURE_DOCINTEL_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_DOCINTEL_KEY=<key>

# Azure OpenAI (only needed for --llm)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_KEY=<key>
AZURE_OPENAI_DEPLOYMENT=<deployment-name>
AZURE_OPENAI_API_VERSION=2024-10-21

# Backend used by the API: local or azure
TAXDOC_BACKEND=local
